# Copy to .env for local runs. Never commit real values.
# All are optional: without them RepoRadar collects, compares and builds the site,
# but skips summaries and only writes Telegram digests to state/outbox/ (dry run).

# GitHub API (raises rate limit from 60 to 5,000 req/h). A fine-grained token
# with NO repository permissions (public read only) is enough. In Actions the
# built-in GITHUB_TOKEN is used automatically.
GITHUB_TOKEN=

# Learning summaries (any OpenAI-compatible chat-completions API). Paid usage.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Telegram digest (only sent when config/notifications.json has "enabled": true
# AND the command is run with --send).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
